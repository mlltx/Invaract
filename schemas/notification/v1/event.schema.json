{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mlltx.github.io/Invaract/schemas/notification/v1/event.schema.json",
  "title": "Invaract notification event (schema version 1)",
  "description": "Every event an Invaract notification sink publishes, as one JSON object. Discriminate on `eventType`. Receivers MUST ignore fields they do not know and tolerate new `status` values: additive changes do not bump `schemaVersion`; only a removed or renamed field, or a changed type, does.",
  "oneOf": [
    { "$ref": "#/$defs/ContractValidationEvent" },
    { "$ref": "#/$defs/WriteEvent" },
    { "$ref": "#/$defs/JobSummaryEvent" },
    { "$ref": "#/$defs/ContractInferenceEvent" },
    { "$ref": "#/$defs/DryRunSummaryEvent" }
  ],
  "$defs": {
    "Envelope": {
      "description": "Fields on every event.",
      "type": "object",
      "required": ["schemaVersion", "eventId", "eventType", "timestamp"],
      "properties": {
        "schemaVersion": { "const": 1, "description": "Version of this JSON shape." },
        "eventId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of the event's own content, deterministic: re-sending the same event (a retry, a replay from a dead-letter file) yields the same id. Delivery is at-least-once, so deduplicate on this."
        },
        "eventType": { "type": "string" },
        "timestamp": { "type": "integer", "description": "Milliseconds since the Unix epoch, when the event was created." }
      }
    },

    "Violation": {
      "type": "object",
      "required": ["type", "message", "remediation"],
      "properties": {
        "type": { "type": "string", "description": "A violation type such as MISSING_OUTPUT_FIELD or UNDECLARED_INPUT." },
        "message": { "type": "string" },
        "remediation": { "type": "string" },
        "column": { "type": "string" },
        "location": { "type": "string" },
        "expected": { "type": "string" },
        "actual": { "type": "string" },
        "rule": { "type": "string" }
      }
    },
    "Fingerprint": {
      "type": "object",
      "required": ["version", "algorithm", "value"],
      "properties": {
        "version": { "type": "integer" },
        "algorithm": { "type": "string" },
        "value": { "type": "string" }
      }
    },
    "OutputFingerprint": {
      "type": "object",
      "required": ["expression", "lineage", "combined", "nonDeterministic"],
      "properties": {
        "expression": { "$ref": "#/$defs/Fingerprint" },
        "lineage": { "$ref": "#/$defs/Fingerprint" },
        "combined": { "$ref": "#/$defs/Fingerprint" },
        "nonDeterministic": { "type": ["boolean", "null"] }
      }
    },
    "TransformationFingerprint": {
      "description": "Present only when fingerprinting is on (always, for dry-run events).",
      "type": "object",
      "required": ["version", "overall", "inputs", "outputs", "rowMutation"],
      "properties": {
        "version": { "type": "integer" },
        "overall": { "$ref": "#/$defs/Fingerprint" },
        "inputs": { "type": "object", "additionalProperties": { "$ref": "#/$defs/Fingerprint" } },
        "outputs": { "type": "object", "additionalProperties": { "$ref": "#/$defs/OutputFingerprint" } },
        "rowMutation": { "oneOf": [{ "$ref": "#/$defs/Fingerprint" }, { "type": "null" }] }
      }
    },
    "DataQualityCheckResult": {
      "type": "object",
      "required": ["field", "constraint", "verdict"],
      "properties": {
        "field": { "type": "string" },
        "constraint": { "type": "string" },
        "verdict": { "type": "string", "description": "Guaranteed, NotGuaranteed, Violated or NotStaticallyVerifiable." }
      }
    },
    "RoleConformanceCheckResult": {
      "type": "object",
      "required": ["dataset", "datasetType", "verdict", "detail"],
      "properties": {
        "dataset": { "type": "string" },
        "datasetType": { "type": "string", "description": "DATA_ASSET, SOURCE or CONTROL." },
        "verdict": { "type": "string" },
        "detail": { "type": "string" }
      }
    },
    "UnverifiableInput": {
      "type": "object",
      "required": ["inputName", "inputLocation", "unknownNodeTypes"],
      "properties": {
        "inputName": { "type": "string" },
        "inputLocation": { "type": "string" },
        "unknownNodeTypes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "CatalogInfo": {
      "type": "object",
      "required": ["namespace"],
      "properties": {
        "technology": { "type": "string" },
        "catalogName": { "type": "string" },
        "location": { "type": "string" },
        "namespace": { "type": "array", "items": { "type": "string" } },
        "table": { "type": "string" }
      }
    },
    "JobInfo": {
      "description": "Where an event came from: which engine and which job.",
      "type": "object",
      "required": ["attributes"],
      "properties": {
        "runId": { "type": "string", "description": "The engine's own identifier for this run (Spark: the application id)." },
        "name": { "type": "string", "description": "The engine's own name for the application (Spark: spark.app.name)." },
        "jobId": { "type": "string", "description": "The job's stable identity across runs, set through the engine's configuration (Spark: spark.invaract.jobId). Absent if the platform did not set it." },
        "engine": { "type": "string", "description": "Which adapter produced the event, e.g. \"spark\"." },
        "engineVersion": { "type": "string" },
        "engineDetails": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Engine-specific facts about where the run executed (Spark: master, deployMode). Free-form by design."
        },
        "user": { "type": "string" },
        "startTimeMs": { "type": "integer" },
        "attributes": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Every spark.invaract.job.metadata.<key>=<value> conf entry, prefix stripped: facts about this one run (an orchestrator run id, a DAG, a trigger). They are never written into the draft contract."
        }
      }
    },

    "ContractValidationEvent": {
      "description": "A write (or state-changing CALL) was checked against a contract. status is PASSED or FAILED.",
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "type": "object",
      "required": ["contract", "status", "violations", "metadata", "runId", "fingerprints", "dataQuality", "roleConformance", "unverifiableInputs", "job"],
      "properties": {
        "eventType": { "const": "CONTRACT_VALIDATION" },
        "contract": { "type": "string", "description": "id@version" },
        "status": { "type": "string", "description": "PASSED or FAILED." },
        "violations": { "type": "array", "items": { "$ref": "#/$defs/Violation" } },
        "metadata": { "type": "object", "description": "The contract's own `extensions` block, verbatim." },
        "runId": { "type": ["string", "null"] },
        "fingerprints": { "oneOf": [{ "$ref": "#/$defs/TransformationFingerprint" }, { "type": "null" }] },
        "dataQuality": { "type": "array", "items": { "$ref": "#/$defs/DataQualityCheckResult" } },
        "roleConformance": { "type": "array", "items": { "$ref": "#/$defs/RoleConformanceCheckResult" } },
        "unverifiableInputs": { "type": "array", "items": { "$ref": "#/$defs/UnverifiableInput" } },
        "job": { "oneOf": [{ "$ref": "#/$defs/JobInfo" }, { "type": "null" }], "description": "Which engine and which job produced the event (engine, engineVersion, jobId, runId, attributes). null only if the adapter supplied none." }
      }
    },
    "WriteEvent": {
      "description": "A write the engine actually executed successfully.",
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "type": "object",
      "required": [
        "contract", "location", "format", "saveMode", "schema", "metadata", "durationMs", "rowCount", "bytesWritten",
        "fileCount", "runId", "deltaVersion", "icebergSnapshotId", "operation", "catalog", "partitionColumns", "datasetType", "job"
      ],
      "properties": {
        "eventType": { "const": "WRITE" },
        "contract": { "type": ["string", "null"] },
        "location": { "type": "string" },
        "format": { "type": ["string", "null"] },
        "saveMode": { "type": ["string", "null"] },
        "schema": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type", "nullable"],
            "properties": { "name": { "type": "string" }, "type": { "type": "string" }, "nullable": { "type": "boolean" } }
          }
        },
        "metadata": { "type": "object" },
        "durationMs": { "type": "integer" },
        "rowCount": { "type": ["integer", "null"] },
        "bytesWritten": { "type": ["integer", "null"] },
        "fileCount": { "type": ["integer", "null"] },
        "runId": { "type": ["string", "null"] },
        "deltaVersion": { "type": ["integer", "null"] },
        "icebergSnapshotId": { "type": ["integer", "null"] },
        "operation": { "type": ["string", "null"], "description": "merge, update or delete for row-level DML; otherwise null." },
        "catalog": { "oneOf": [{ "$ref": "#/$defs/CatalogInfo" }, { "type": "null" }] },
        "partitionColumns": { "type": "array", "items": { "type": "string" } },
        "datasetType": { "type": ["string", "null"], "description": "DATA_ASSET, SOURCE or CONTROL, if the contract declares one for this output." },
        "job": { "oneOf": [{ "$ref": "#/$defs/JobInfo" }, { "type": "null" }], "description": "Which engine and which job produced the event (engine, engineVersion, jobId, runId, attributes). null only if the adapter supplied none." }
      }
    },
    "JobSummaryEvent": {
      "description": "Aggregate over the events a SummarizingNotificationSink saw (enforcement mode).",
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "type": "object",
      "required": ["totalWrites", "checksPassed", "checksFailed", "totalViolations", "durationMs", "metadata", "runId", "job"],
      "properties": {
        "eventType": { "const": "JOB_SUMMARY" },
        "totalWrites": { "type": "integer" },
        "checksPassed": { "type": "integer" },
        "checksFailed": { "type": "integer" },
        "totalViolations": { "type": "integer" },
        "durationMs": { "type": "integer" },
        "metadata": { "type": "object" },
        "runId": { "type": ["string", "null"] },
        "job": { "oneOf": [{ "$ref": "#/$defs/JobInfo" }, { "type": "null" }], "description": "Which engine and which job produced the event (engine, engineVersion, jobId, runId, attributes). null only if the adapter supplied none." }
      }
    },
    "ContractInferenceEvent": {
      "description": "Dry-run mode tried to infer a contract for one write, or met a write it could not infer from.",
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "type": "object",
      "required": [
        "status", "reason", "writeLocation", "contractYaml", "contractDigest", "selfCheck", "selfCheckViolations",
        "diagnostics", "fingerprints", "job", "metadata"
      ],
      "properties": {
        "eventType": { "const": "CONTRACT_INFERENCE" },
        "status": {
          "type": "string",
          "description": "INFERRED, INFERRED_DEGRADED, SKIPPED_UNSUPPORTED, SKIPPED_UNRECOGNIZED or INFERENCE_ERROR. More may be added; treat an unknown value as 'needs a look'."
        },
        "reason": { "type": ["string", "null"], "description": "Why the status is not plain INFERRED." },
        "writeLocation": { "type": ["string", "null"] },
        "contractYaml": { "type": ["string", "null"], "description": "The inferred draft, in Invaract's contract YAML. Present for INFERRED and INFERRED_DEGRADED." },
        "contractDigest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 of contractYaml: identical drafts have identical digests." },
        "selfCheck": { "type": ["string", "null"], "description": "Result of verifying the draft against the very write it came from: PASSED, FAILED, INVALID or ERROR. PASSED means turning enforcement on with this contract would not have blocked that write." },
        "selfCheckViolations": { "type": "array", "items": { "$ref": "#/$defs/Violation" } },
        "diagnostics": { "type": "array", "items": { "type": "string" } },
        "fingerprints": { "oneOf": [{ "$ref": "#/$defs/TransformationFingerprint" }, { "type": "null" }] },
        "job": { "$ref": "#/$defs/JobInfo" },
        "metadata": { "type": "object", "additionalProperties": { "type": "string" }, "description": "The draft contract's `extensions`: whatever the platform set with spark.invaract.contract.metadata.<key>. Facts about the contract (owner, source system), not about this run (those are job.attributes). Once the draft is promoted, ContractValidationEvent.metadata and WriteEvent.metadata carry the same keys. Empty if none were set." }
      }
    },
    "DryRunSummaryEvent": {
      "description": "Once per application, when it ends.",
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "type": "object",
      "required": ["statusCounts", "mergeStatus", "mergedContractYaml", "mergedContractDigest", "mergeConflicts", "job", "metadata"],
      "properties": {
        "eventType": { "const": "DRY_RUN_SUMMARY" },
        "statusCounts": {
          "type": "object",
          "additionalProperties": { "type": "integer" },
          "description": "Count of writes per ContractInferenceEvent status. NO_WRITES_OBSERVED: 1 when the job wrote nothing Invaract recognized."
        },
        "mergeStatus": { "type": "string", "description": "MERGED, CONFLICT or NO_DRAFTS." },
        "mergedContractYaml": { "type": ["string", "null"], "description": "Every draft of the run merged into one contract. Present only when mergeStatus is MERGED." },
        "mergedContractDigest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "mergeConflicts": { "type": "array", "items": { "type": "string" } },
        "job": { "$ref": "#/$defs/JobInfo" },
        "metadata": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Same as on ContractInferenceEvent: the contract metadata (spark.invaract.contract.metadata.*), also present in mergedContractYaml's extensions." }
      }
    }
  }
}
