// The @@Engine@@ adapter: translates @@Engine@@'s jobs into the engine-neutral IR and hands them to
// verification-core's VerificationPipeline. Generated by dev/new-adapter; the guide that says what to do
// next, and why, is docs/ADDING_AN_ENGINE_ADAPTER.md.
//
// Depends on contract, ir and verification-core (never on another engine's adapter), and on the conformance
// kit only in tests. Versions of the sibling modules are pinned to what the repository has now;
// .github/scripts/check_modules.py fails a pin that is left behind.
ThisBuild / version := "0.1.0"
scalaVersion := "2.12.18"
organization := "com.invaract"

// --- Maven Central publishing (Central Portal) ---
// Copied from adapter-testkit/build.sbt at generation time, so the modules cannot drift.
@@PUBLISHING@@
name := "invaract-@@engine@@-adapter"

libraryDependencies ++= Seq(
  "com.invaract" %% "invaract-contract" % "@@CONTRACT_VERSION@@",
  "com.invaract" %% "invaract-ir" % "@@IR_VERSION@@",
  "com.invaract" %% "invaract-verification-core" % "@@VERIFICATION_CORE_VERSION@@",
  "com.invaract" %% "invaract-adapter-testkit" % "@@KIT_VERSION@@" % "test",
  "org.scalatest" %% "scalatest" % "3.2.18" % "test",
  // verification-core's own `provided` dependencies, needed to run its classes here.
  "org.slf4j" % "slf4j-api" % "2.0.17" % "provided",
  "org.slf4j" % "slf4j-simple" % "2.0.7" % "test"
)

scalacOptions ++= Seq(
  "-target:jvm-1.8",
  "-deprecation",
  "-feature"
)

Test / fork := true

// API compatibility (MiMa), the gate the other published modules have. A module with no release has nothing to
// compare with: set this to the first released version, and add the module to the CI loops (check_modules.py says where).
import com.typesafe.tools.mima.core._
mimaPreviousArtifacts := Set.empty

// Line/branch coverage gating (sbt-scoverage). These are a starting floor, not a measurement: once the adapter
// has real code, run `sbt coverage test coverageReport`, then pin both a few points under what you measure
// (CLAUDE.md's "Coverage Gating Requirement"). Never lower them to make a failure go away.
coverageScalacPluginVersion := "2.4.2"
coverageMinimumStmtTotal := 50
coverageMinimumBranchTotal := 30
coverageFailOnMinimum := true
coverageHighlighting := true

// Mutation testing (Stryker4s), the same convention as the other engine modules (CLAUDE.md's "Mutation Testing
// Requirement"). `StringLiteral` is excluded because messages are human-readable text. Pin `Break` a few points
// under a real whole-module run; new code in this module is held to 70% when you touch it.
strykerMutate := Seq("src/main/scala/**/*.scala")
strykerExcludedMutations := Seq("StringLiteral")
strykerThresholdsHigh := 90
strykerThresholdsLow := 80
strykerThresholdsBreak := 70
