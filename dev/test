#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$SCRIPT_DIR"
source dev/lib.sh

echo "======================================"
echo "Invaract Spark Plugin Test Suite"
echo "======================================"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

REPORT_DIR="demo/output"
REPORT_FILE="$REPORT_DIR/report.json"

cleanup() {
  local exit_code=$?
  if [ $exit_code -ne 0 ]; then
    echo -e "${RED}✕ Test suite failed${NC}"
  fi
  return $exit_code
}

trap cleanup EXIT

# Step 1: Build all modules
# dev/build compiles+tests+assembles contract, ir, plugin and spark-adapter
# before runner, in that order — required because runner's build.sbt pulls
# each of their jars in via unmanagedJars (no aggregating root build.sbt
# links these independent sbt projects). Building only plugin+runner here,
# as this script used to, works only by accident once the other three jars
# already exist on disk from an earlier build; on a genuinely fresh clone
# it fails with "not found: type ContractViolationException" etc. in
# runner's compile step.
echo ""
echo -e "${YELLOW}Step 1/7: Building all modules...${NC}"
./dev/build

if [ ! -f "$PLUGIN_JAR" ]; then
  echo -e "${RED}✗ Plugin JAR not found: $PLUGIN_JAR${NC}"
  exit 1
fi
if [ ! -f "$RUNNER_JAR" ]; then
  echo -e "${RED}✗ Runner JAR not found: $RUNNER_JAR${NC}"
  exit 1
fi
echo -e "${GREEN}✓ All modules built successfully${NC}"

# Step 2: Verify plugin JAR
echo ""
echo -e "${YELLOW}Step 2/7: Verifying plugin JAR...${NC}"
JAR_SIZE=$(du -h "$PLUGIN_JAR" | cut -f1)
echo "  JAR size: $JAR_SIZE"
echo "  Main classes:"
jar tf "$PLUGIN_JAR" | grep "com/example/plugin" | head -5

# Step 3: Verify runner JAR
echo ""
echo -e "${YELLOW}Step 3/7: Verifying runner JAR...${NC}"
RUNNER_JAR_SIZE=$(du -h "$RUNNER_JAR" | cut -f1)
echo "  JAR size: $RUNNER_JAR_SIZE"

# Step 4: Verify Spark availability
echo ""
echo -e "${YELLOW}Step 4/7: Verifying Spark environment...${NC}"
if command -v spark-submit &> /dev/null; then
  SPARK_VERSION=$(spark-submit --version 2>&1 | grep "version" | head -1)
  echo "  Spark: $SPARK_VERSION"
else
  echo -e "${YELLOW}⚠ spark-submit not in PATH, will use local execution${NC}"
fi

# Step 5: Prepare output directory
echo ""
echo -e "${YELLOW}Step 5/7: Preparing output directory...${NC}"
mkdir -p "$REPORT_DIR"
rm -f "$REPORT_FILE"

# Step 6: Run Spark Job
echo ""
echo -e "${YELLOW}Step 6/7: Executing Spark integration test...${NC}"
echo "  Input: demo/input/sample.csv"
echo "  Output: demo/output/result.parquet"
echo "  Report: $REPORT_FILE"

run_demo_job_harness "demo/input/sample.csv" "demo/output/result.parquet" "$REPORT_FILE"
SPARK_EXIT=$?

# Step 7: Validate Report
echo ""
echo -e "${YELLOW}Step 7/7: Validating execution report...${NC}"

if [ ! -f "$REPORT_FILE" ]; then
  echo -e "${RED}✗ Report file not generated${NC}"
  exit 1
fi

# Parse report. `head -1` takes the first match only: report.json's
# top-level fields are written first (see DemoJobHarness.reportToJson), but
# nested sections (contractVerification.status, buildInfo.pluginVersion)
# can carry same-named keys, and a naive grep matches all of them.
STATUS=$(grep -o '"status": "[^"]*"' "$REPORT_FILE" | head -1 | cut -d'"' -f4)
PLUGIN_VERSION=$(grep -o '"pluginVersion": "[^"]*"' "$REPORT_FILE" | head -1 | cut -d'"' -f4)
DURATION=$(grep -o '"durationMs": [0-9]*' "$REPORT_FILE" | head -1 | cut -d' ' -f2)

echo "  Status: $STATUS"
echo "  Plugin Version: $PLUGIN_VERSION"
echo "  Duration: ${DURATION}ms"

if [ "$STATUS" != "PASS" ]; then
  echo -e "${RED}✗ Plugin execution failed${NC}"
  cat "$REPORT_FILE"
  exit 1
fi

echo ""
echo -e "${GREEN}✓ All validation passed${NC}"
echo -e "${GREEN}✓ Plugin JAR is ready: $PLUGIN_JAR${NC}"
echo -e "${GREEN}✓ Execution report: $REPORT_FILE${NC}"
echo ""
echo "To view results in web UI:"
echo "  ./dev/report"
echo ""

exit 0
