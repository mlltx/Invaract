#!/bin/bash
# Builds every sbt module in dependency order and assembles a fat jar for
# each. Each top-level module (contract/, ir/, plugin/, spark-adapter/,
# runner/) is an independent sbt project (no aggregating root build.sbt);
# cross-module references go through `unmanagedJars` pointing at a sibling
# module's target/scala-2.12/*.jar, so a dependency's jar must exist and be
# up to date *before* sbt compiles anything that depends on it. This script
# is the single source of truth for that order — see build.sbt in each
# module for the unmanagedJars lines that encode it:
#
#   contract, ir, plugin   (no cross-module deps, can build first)
#   spark-adapter          (needs contract, ir)
#   runner                 (needs contract, ir, plugin, spark-adapter)
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$SCRIPT_DIR"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

build_module() {
  local module="$1"
  local sbt_command="$2"
  echo ""
  echo -e "${YELLOW}Building $module ($sbt_command)...${NC}"

  # Piping sbt into grep, as this used to do, discards sbt's own exit code
  # (the pipeline's status becomes grep's) and — worse — the filter itself
  # (only lines matching error/Test/BUILD) drops most scalatest failure
  # detail (e.g. "*** FAILED ***" lines and assertion messages don't
  # match), so a real failure printed a misleadingly brief summary and
  # this function still reported success regardless. Capture the full
  # output instead: show the brief filtered summary on success, but dump
  # everything and fail loudly on a real failure.
  local log_file
  log_file="$(mktemp)"
  if (cd "$module" && sbt -batch clean $sbt_command) > "$log_file" 2>&1; then
    grep -E "^(.*error.*|.*Test.*|.*BUILD.*)" "$log_file" || true
    echo -e "${GREEN}✓ $module built${NC}"
    rm -f "$log_file"
  else
    echo -e "${RED}✗ $module failed${NC}"
    cat "$log_file"
    rm -f "$log_file"
    exit 1
  fi
}

build_module contract      "compile test assembly"
build_module ir            "compile test assembly"
build_module plugin        "compile test assembly"
build_module spark-adapter "compile test assembly"
build_module runner        "compile assembly"

echo ""
echo -e "${GREEN}✓ All modules built${NC}"
