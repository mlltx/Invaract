#!/bin/bash
# Builds every sbt module and assembles a fat jar for each. Each top-level
# module (contract/, ir/, plugin/, spark-adapter/, runner/) is an
# independent sbt project (no aggregating root build.sbt). Cross-module
# references split two ways:
#
#   - contract, ir, spark-adapter (the three modules Maven Central
#     publishing is set up for — see CLAUDE.md's "What's the product") are
#     real `libraryDependencies` against each other's own published
#     coordinate, resolved from the local Ivy cache. That means the
#     dependency's `publishLocal` must have run — not just `compile`/
#     `assembly` — *before* sbt resolves anything that depends on it, or
#     resolution fails exactly the way a real Central lookup would if the
#     artifact didn't exist yet.
#   - plugin, the demo harness's example transformation (never published to
#     Central), is still referenced via `unmanagedJars` pointing at its
#     assembled jar directly — runner's build.sbt keeps that one line for
#     exactly this reason.
#
# This script is the single source of truth for the resulting build order —
# see build.sbt in each module for the libraryDependencies/unmanagedJars
# lines that encode it:
#
#   contract, ir, plugin   (no cross-module deps — built concurrently)
#   spark-adapter          (needs contract, ir published locally — not plugin)
#   runner                 (needs contract, ir, spark-adapter published
#                            locally, plus plugin's jar directly)
#
# contract/ir/plugin have no dependency on each other, so they build in
# parallel (background jobs) rather than one after another on every OS
# except Windows (see the OSTYPE check below — concurrent sbt/coursier
# cache access hits hard file locks there); spark-adapter starts as soon
# as contract+ir are ready (and locally published), without waiting on
# plugin.
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$SCRIPT_DIR"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# macOS ships Bash 3.2 (Apple has frozen it since 2007 over the GPLv3
# relicense), which has no associative arrays (declare -A is Bash 4+) —
# confirmed the hard way when this first shipped: "declare: -A: invalid
# option" on macos-latest. Parallel indexed arrays instead; both indexed
# arrays and += appends have worked since Bash 3.1.
MODULE_NAMES=()
MODULE_PIDS=()
MODULE_LOGS=()

# start_module MODULE SBT_COMMAND — launches the build in the background
# and records its PID/log file; does not wait for it.
start_module() {
  local module="$1"
  local sbt_command="$2"
  local log_file
  log_file="$(mktemp)"
  echo -e "${YELLOW}Building $module ($sbt_command)...${NC}"
  (cd "$module" && sbt -batch clean $sbt_command) > "$log_file" 2>&1 &
  MODULE_NAMES+=("$module")
  MODULE_PIDS+=("$!")
  MODULE_LOGS+=("$log_file")
}

# wait_module MODULE — blocks until that module's background build
# finishes. Piping sbt into grep, as this used to do, discards sbt's own
# exit code (the pipeline's status becomes grep's) and — worse — the
# filter itself (only lines matching error/Test/BUILD) drops most
# scalatest failure detail (e.g. "*** FAILED ***" lines and assertion
# messages don't match), so a real failure printed a misleadingly brief
# summary and this script still reported success regardless. The captured
# log file avoids that: brief filtered summary on success, full dump and a
# loud failure otherwise.
wait_module() {
  local target="$1"
  local count=${#MODULE_NAMES[@]}
  local i=0
  while [ "$i" -lt "$count" ]; do
    if [ "${MODULE_NAMES[$i]}" = "$target" ]; then
      local log_file="${MODULE_LOGS[$i]}"
      if wait "${MODULE_PIDS[$i]}"; then
        grep -E "^(.*error.*|.*Test.*|.*BUILD.*)" "$log_file" || true
        echo -e "${GREEN}✓ $target built${NC}"
        rm -f "$log_file"
      else
        echo -e "${RED}✗ $target failed${NC}"
        cat "$log_file"
        rm -f "$log_file"
        exit 1
      fi
      return
    fi
    i=$((i + 1))
  done
}

echo ""
if [[ "$OSTYPE" == "msys" || "$OSTYPE" == "cygwin" ]]; then
  # Windows: build sequentially. contract/ir/plugin share the same
  # coursier/ivy cache directory, and Windows enforces hard file locks on
  # it that Linux/macOS tolerate concurrent access to — confirmed by CI:
  # running them in parallel failed plugin's dependency resolution with
  # "not found: ...\Coursier\Cache\v1\.structure.lock (The process cannot
  # access the file because it is being used by another process)".
  start_module contract "compile test assembly publishLocal"
  wait_module contract
  start_module ir "compile test assembly publishLocal"
  wait_module ir
  start_module plugin "compile test assembly"
  wait_module plugin
else
  start_module contract "compile test assembly publishLocal"
  start_module ir       "compile test assembly publishLocal"
  start_module plugin   "compile test assembly"
  wait_module contract
  wait_module ir
  wait_module plugin
fi

echo ""
start_module spark-adapter "compile test assembly publishLocal"
wait_module spark-adapter

echo ""
start_module runner "compile assembly"
wait_module runner

echo ""
echo -e "${GREEN}✓ All modules built${NC}"
