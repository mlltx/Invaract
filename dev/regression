#!/bin/bash
# Contract-enforcement regression pack.
#
# Proves, with a real Spark job and no mocking, that ContractEnforcementRule
# (spark-adapter/.../ContractEnforcementRule.scala) does what Phase 5 of
# ROADMAP.md requires:
#   1. a transformation that satisfies its contract executes and writes
#      its output, and
#   2. a transformation that violates its contract is aborted *before* any
#      output is written — not flagged after the fact.
#
# This is the same demonstration documented in docs/SPARK_ADAPTER.md,
# turned into an assertion script so it can be re-run by any contributor,
# in CI, or in the Docker image built from docker/Dockerfile, with a single
# command and a real pass/fail exit code instead of a transcript someone
# has to read.
#
# Cases 3/4 give static data-quality verification (docs/STATIC_DATA_QUALITY_
# VERIFICATION.md) the same real, CI-gated proof Cases 1/2 already give
# schema-level enforcement — a gap the static-data-quality design doc's own
# §11 open question 2 flagged and left unresolved: neither this script nor
# ./dev/test (which this job doesn't even run — see below) exercised
# spark.invaract.staticDataQuality through a real spark-submit job at all
# until now. ./dev/test itself stays a purely local/interactive script
# (dev/lib.sh's own doc; this repository's CI job runs ./dev/build then
# this script, never ./dev/test), so this is genuinely the only place that
# gap could be closed for something CI actually runs.
#
# Cases 5/6 give the same real, CI-gated proof to role-consistency checking
# (docs/CONTRACT_MODEL.md's "Input and Output Types" section), opt-in via
# spark.invaract.roleConsistency — the same shape Cases 3/4 already
# establish for spark.invaract.staticDataQuality, reusing the exact same
# real transformation and only varying the contract's own declared
# `type:`.
#
# Usage:
#   ./dev/regression            # builds jars first, then runs both cases
#   SKIP_BUILD=1 ./dev/regression   # reuse jars already on disk (faster
#                                    # iteration once dev/build has run once,
#                                    # e.g. inside the Docker image where the
#                                    # image build already ran it)
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$SCRIPT_DIR"
source dev/lib.sh

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

FAILURES=0

check() {
  local description="$1" ok="$2"
  if [ "$ok" = "true" ]; then
    echo -e "  ${GREEN}✓${NC} $description"
  else
    echo -e "  ${RED}✗${NC} $description"
    FAILURES=$((FAILURES + 1))
  fi
}

report_field() {
  # report_field FILE JSON_POINTER-ish-key -> first matching top-level value
  grep -o "\"$2\": *\"[^\"]*\"" "$1" | head -1 | cut -d'"' -f4
}

echo "======================================"
echo "Invaract Contract Regression Pack"
echo "======================================"

if [ "${SKIP_BUILD:-}" != "1" ]; then
  ./dev/build
else
  echo ""
  echo "SKIP_BUILD=1 set, reusing existing jars."
fi

if [ ! -f "$PLUGIN_JAR" ] || [ ! -f "$RUNNER_JAR" ]; then
  echo -e "${RED}✗ Required jars missing after build — cannot run regression pack.${NC}"
  exit 1
fi

mkdir -p demo/output

# --- Case 1: contract satisfied -> execute -------------------------------
echo ""
echo -e "${YELLOW}Case 1/6: contract satisfied -> transformation executes${NC}"
echo "  contract: demo/contracts/invaract_output.yaml"

# Output location must match what the contract declares — StructuralVerifier
# checks that too (OUTPUT_LOCATION_MISMATCH), so this can't be an arbitrary
# path of our choosing the way the report path can.
PASS_OUTPUT="demo/output/result.parquet"
PASS_REPORT="demo/output/regression_pass_report.json"
PASS_EVENTS="demo/output/regression_pass_events.jsonl"
rm -rf "$PASS_OUTPUT" "$PASS_REPORT" "$PASS_EVENTS"

run_demo_job_harness "demo/input/sample.csv" "$PASS_OUTPUT" "$PASS_REPORT" \
  "demo/contracts/invaract_output.yaml" "demo/regression-notify-pass.properties"
PASS_EXIT=$?

PASS_STATUS="$(report_field "$PASS_REPORT" status)"

[ "$PASS_EXIT" = "0" ] && ec_ok=true || ec_ok=false
check "spark-submit exits 0" "$ec_ok"

[ "$PASS_STATUS" = "PASS" ] && st_ok=true || st_ok=false
check "report status is PASS (got '$PASS_STATUS')" "$st_ok"

[ -e "$PASS_OUTPUT" ] && out_ok=true || out_ok=false
check "output was written to $PASS_OUTPUT" "$out_ok"

if grep -q '"eventType": "CONTRACT_VALIDATION"' "$PASS_EVENTS" 2>/dev/null && grep -q '"status": "PASSED"' "$PASS_EVENTS" 2>/dev/null; then
  pass_event_ok=true
else
  pass_event_ok=false
fi
check "a PASSED ContractValidationEvent was published to $PASS_EVENTS" "$pass_event_ok"

if grep -q '"eventType": "WRITE"' "$PASS_EVENTS" 2>/dev/null; then
  pass_write_event_ok=true
else
  pass_write_event_ok=false
fi
check "a WriteEvent was published to $PASS_EVENTS once the write completed" "$pass_write_event_ok"

if grep -q '"eventType": "JOB_SUMMARY"' "$PASS_EVENTS" 2>/dev/null && grep -q '"checksPassed": 1' "$PASS_EVENTS" 2>/dev/null && grep -q '"checksFailed": 0' "$PASS_EVENTS" 2>/dev/null; then
  pass_summary_event_ok=true
else
  pass_summary_event_ok=false
fi
check "a JobSummaryEvent (checksPassed=1, checksFailed=0) was published to $PASS_EVENTS" "$pass_summary_event_ok"

# --- Case 2: contract violated -> abort before write ----------------------
echo ""
echo -e "${YELLOW}Case 2/6: contract violated -> write aborted, no output${NC}"
echo "  contract: demo/contracts/invaract_output_broken_example.yaml"

FAIL_OUTPUT="demo/output/result_broken_example.parquet"
FAIL_REPORT="demo/output/regression_fail_report.json"
FAIL_EVENTS="demo/output/regression_fail_events.jsonl"
rm -rf "$FAIL_OUTPUT" "$FAIL_REPORT" "$FAIL_EVENTS"

run_demo_job_harness "demo/input/sample.csv" "$FAIL_OUTPUT" "$FAIL_REPORT" \
  "demo/contracts/invaract_output_broken_example.yaml" "demo/regression-notify-fail.properties"
FAIL_EXIT=$?

FAIL_STATUS="$(report_field "$FAIL_REPORT" status)"

[ "$FAIL_EXIT" != "0" ] && ec_ok=true || ec_ok=false
check "spark-submit exits non-zero (got $FAIL_EXIT)" "$ec_ok"

[ "$FAIL_STATUS" = "FAIL" ] && st_ok=true || st_ok=false
check "report status is FAIL (got '$FAIL_STATUS')" "$st_ok"

if grep -q "MISSING_OUTPUT_FIELD" "$FAIL_REPORT" 2>/dev/null; then
  violation_ok=true
else
  violation_ok=false
fi
check "report identifies the MISSING_OUTPUT_FIELD violation" "$violation_ok"

if [ ! -e "$FAIL_OUTPUT" ]; then
  no_output_ok=true
else
  no_output_ok=false
fi
check "no output was written at $FAIL_OUTPUT (write was actually aborted)" "$no_output_ok"

if grep -q '"eventType": "CONTRACT_VALIDATION"' "$FAIL_EVENTS" 2>/dev/null && grep -q '"status": "FAILED"' "$FAIL_EVENTS" 2>/dev/null; then
  fail_event_ok=true
else
  fail_event_ok=false
fi
check "a FAILED ContractValidationEvent was published to $FAIL_EVENTS before the write was aborted" "$fail_event_ok"

if grep -q '"eventType": "WRITE"' "$FAIL_EVENTS" 2>/dev/null; then
  fail_write_event_ok=false
else
  fail_write_event_ok=true
fi
check "no WriteEvent was published to $FAIL_EVENTS (the write never executed)" "$fail_write_event_ok"

if grep -q '"eventType": "JOB_SUMMARY"' "$FAIL_EVENTS" 2>/dev/null && grep -q '"checksPassed": 0' "$FAIL_EVENTS" 2>/dev/null && grep -q '"checksFailed": 1' "$FAIL_EVENTS" 2>/dev/null; then
  fail_summary_event_ok=true
else
  fail_summary_event_ok=false
fi
check "a JobSummaryEvent (checksPassed=0, checksFailed=1) was published to $FAIL_EVENTS even though the job aborted" "$fail_summary_event_ok"

# --- Case 3: data-quality satisfied -> execute, Guaranteed reported -------
echo ""
echo -e "${YELLOW}Case 3/6: data-quality constraint satisfied -> transformation executes${NC}"
echo "  contract: demo/contracts/invaract_output_data_quality_pass.yaml"

DQ_PASS_OUTPUT="demo/output/result_dq_pass.parquet"
DQ_PASS_REPORT="demo/output/regression_dq_pass_report.json"
DQ_PASS_EVENTS="demo/output/regression_dq_pass_events.jsonl"
rm -rf "$DQ_PASS_OUTPUT" "$DQ_PASS_REPORT" "$DQ_PASS_EVENTS"

# value_tier's own CASE WHEN value > 50 THEN 'high' ELSE 'low' END proves
# oneOf [high, low] Guaranteed with no input axiom at all (Example 3) -
# real spark.invaract.staticDataQuality attachment purely via --conf,
# same as any real job would use (External Attachability Requirement).
SPARK_SUBMIT_EXTRA_CONF="spark.invaract.staticDataQuality=true" \
  run_demo_job_harness "demo/input/sample.csv" "$DQ_PASS_OUTPUT" "$DQ_PASS_REPORT" \
  "demo/contracts/invaract_output_data_quality_pass.yaml" "demo/regression-notify-dq-pass.properties"
DQ_PASS_EXIT=$?

DQ_PASS_STATUS="$(report_field "$DQ_PASS_REPORT" status)"

[ "$DQ_PASS_EXIT" = "0" ] && ec_ok=true || ec_ok=false
check "spark-submit exits 0" "$ec_ok"

[ "$DQ_PASS_STATUS" = "PASS" ] && st_ok=true || st_ok=false
check "report status is PASS (got '$DQ_PASS_STATUS')" "$st_ok"

[ -e "$DQ_PASS_OUTPUT" ] && out_ok=true || out_ok=false
check "output was written to $DQ_PASS_OUTPUT" "$out_ok"

if grep -q '"eventType": "CONTRACT_VALIDATION"' "$DQ_PASS_EVENTS" 2>/dev/null \
  && grep -q '"field": "value_tier"' "$DQ_PASS_EVENTS" 2>/dev/null \
  && grep -q '"verdict": "Guaranteed"' "$DQ_PASS_EVENTS" 2>/dev/null; then
  dq_pass_event_ok=true
else
  dq_pass_event_ok=false
fi
check "a ContractValidationEvent with value_tier's dataQuality verdict Guaranteed was published to $DQ_PASS_EVENTS" "$dq_pass_event_ok"

# --- Case 4: data-quality violated -> abort before write ------------------
echo ""
echo -e "${YELLOW}Case 4/6: data-quality constraint violated -> write aborted, no output${NC}"
echo "  contract: demo/contracts/invaract_output_data_quality_fail.yaml"

DQ_FAIL_OUTPUT="demo/output/result_dq_fail.parquet"
DQ_FAIL_REPORT="demo/output/regression_dq_fail_report.json"
DQ_FAIL_EVENTS="demo/output/regression_dq_fail_events.jsonl"
rm -rf "$DQ_FAIL_OUTPUT" "$DQ_FAIL_REPORT" "$DQ_FAIL_EVENTS"

# This contract's oneOf on value_tier deliberately excludes 'low', which
# the ELSE branch above provably produces - a real DataQualityViolation
# (ViolationType.DataQualityViolation), aborting the write before any data
# is written, the same proof Case 2 gives for a structural violation.
SPARK_SUBMIT_EXTRA_CONF="spark.invaract.staticDataQuality=true" \
  run_demo_job_harness "demo/input/sample.csv" "$DQ_FAIL_OUTPUT" "$DQ_FAIL_REPORT" \
  "demo/contracts/invaract_output_data_quality_fail.yaml" "demo/regression-notify-dq-fail.properties"
DQ_FAIL_EXIT=$?

DQ_FAIL_STATUS="$(report_field "$DQ_FAIL_REPORT" status)"

[ "$DQ_FAIL_EXIT" != "0" ] && ec_ok=true || ec_ok=false
check "spark-submit exits non-zero (got $DQ_FAIL_EXIT)" "$ec_ok"

[ "$DQ_FAIL_STATUS" = "FAIL" ] && st_ok=true || st_ok=false
check "report status is FAIL (got '$DQ_FAIL_STATUS')" "$st_ok"

if grep -q "DATA_QUALITY_VIOLATION" "$DQ_FAIL_REPORT" 2>/dev/null; then
  dq_violation_ok=true
else
  dq_violation_ok=false
fi
check "report identifies the DATA_QUALITY_VIOLATION violation" "$dq_violation_ok"

if [ ! -e "$DQ_FAIL_OUTPUT" ]; then
  dq_no_output_ok=true
else
  dq_no_output_ok=false
fi
check "no output was written at $DQ_FAIL_OUTPUT (write was actually aborted)" "$dq_no_output_ok"

if grep -q '"eventType": "CONTRACT_VALIDATION"' "$DQ_FAIL_EVENTS" 2>/dev/null \
  && grep -q '"status": "FAILED"' "$DQ_FAIL_EVENTS" 2>/dev/null \
  && grep -q '"field": "value_tier"' "$DQ_FAIL_EVENTS" 2>/dev/null \
  && grep -q '"verdict": "Violated"' "$DQ_FAIL_EVENTS" 2>/dev/null; then
  dq_fail_event_ok=true
else
  dq_fail_event_ok=false
fi
check "a FAILED ContractValidationEvent with value_tier's dataQuality verdict Violated was published to $DQ_FAIL_EVENTS before the write was aborted" "$dq_fail_event_ok"

if grep -q '"eventType": "WRITE"' "$DQ_FAIL_EVENTS" 2>/dev/null; then
  dq_fail_write_event_ok=false
else
  dq_fail_write_event_ok=true
fi
check "no WriteEvent was published to $DQ_FAIL_EVENTS (the write never executed)" "$dq_fail_write_event_ok"

# --- Case 5: role consistency satisfied -> execute, Conforms reported ----
echo ""
echo -e "${YELLOW}Case 5/6: declared dataset type consistent with observed usage -> transformation executes${NC}"
echo "  contract: demo/contracts/invaract_output_role_consistency_pass.yaml"

ROLE_PASS_OUTPUT="demo/output/result_role_pass.parquet"
ROLE_PASS_REPORT="demo/output/regression_role_pass_report.json"
ROLE_PASS_EVENTS="demo/output/regression_role_pass_events.jsonl"
rm -rf "$ROLE_PASS_OUTPUT" "$ROLE_PASS_REPORT" "$ROLE_PASS_EVENTS"

# `orders` is declared DATA_ASSET, and its `value` column genuinely does
# derive value_squared/value_tier in the produced output - RoleConsistencyVerifier
# reports this Conforms - real spark.invaract.roleConsistency attachment
# purely via --conf, same as any real job would use (External
# Attachability Requirement).
SPARK_SUBMIT_EXTRA_CONF="spark.invaract.roleConsistency=true" \
  run_demo_job_harness "demo/input/sample.csv" "$ROLE_PASS_OUTPUT" "$ROLE_PASS_REPORT" \
  "demo/contracts/invaract_output_role_consistency_pass.yaml" "demo/regression-notify-role-pass.properties"
ROLE_PASS_EXIT=$?

ROLE_PASS_STATUS="$(report_field "$ROLE_PASS_REPORT" status)"

[ "$ROLE_PASS_EXIT" = "0" ] && ec_ok=true || ec_ok=false
check "spark-submit exits 0" "$ec_ok"

[ "$ROLE_PASS_STATUS" = "PASS" ] && st_ok=true || st_ok=false
check "report status is PASS (got '$ROLE_PASS_STATUS')" "$st_ok"

[ -e "$ROLE_PASS_OUTPUT" ] && out_ok=true || out_ok=false
check "output was written to $ROLE_PASS_OUTPUT" "$out_ok"

if grep -q '"eventType": "CONTRACT_VALIDATION"' "$ROLE_PASS_EVENTS" 2>/dev/null \
  && grep -q '"dataset": "orders"' "$ROLE_PASS_EVENTS" 2>/dev/null \
  && grep -q '"verdict": "Conforms"' "$ROLE_PASS_EVENTS" 2>/dev/null; then
  role_pass_event_ok=true
else
  role_pass_event_ok=false
fi
check "a ContractValidationEvent with orders' roleConformance verdict Conforms was published to $ROLE_PASS_EVENTS" "$role_pass_event_ok"

# --- Case 6: role consistency violated -> abort before write -------------
echo ""
echo -e "${YELLOW}Case 6/6: declared dataset type contradicted by observed usage -> write aborted, no output${NC}"
echo "  contract: demo/contracts/invaract_output_role_consistency_fail.yaml"

ROLE_FAIL_OUTPUT="demo/output/result_role_fail.parquet"
ROLE_FAIL_REPORT="demo/output/regression_role_fail_report.json"
ROLE_FAIL_EVENTS="demo/output/regression_role_fail_events.jsonl"
rm -rf "$ROLE_FAIL_OUTPUT" "$ROLE_FAIL_REPORT" "$ROLE_FAIL_EVENTS"

# `orders` is declared CONTROL, yet its `value` column genuinely does
# derive value_squared/value_tier in the produced output - the spec's own
# high-confidence contradiction - a real ROLE_CONSISTENCY_VIOLATION
# (ViolationType.RoleConsistencyViolation), aborting the write before any
# data is written, the same proof Case 4 gives for a data-quality
# violation.
SPARK_SUBMIT_EXTRA_CONF="spark.invaract.roleConsistency=true" \
  run_demo_job_harness "demo/input/sample.csv" "$ROLE_FAIL_OUTPUT" "$ROLE_FAIL_REPORT" \
  "demo/contracts/invaract_output_role_consistency_fail.yaml" "demo/regression-notify-role-fail.properties"
ROLE_FAIL_EXIT=$?

ROLE_FAIL_STATUS="$(report_field "$ROLE_FAIL_REPORT" status)"

[ "$ROLE_FAIL_EXIT" != "0" ] && ec_ok=true || ec_ok=false
check "spark-submit exits non-zero (got $ROLE_FAIL_EXIT)" "$ec_ok"

[ "$ROLE_FAIL_STATUS" = "FAIL" ] && st_ok=true || st_ok=false
check "report status is FAIL (got '$ROLE_FAIL_STATUS')" "$st_ok"

if grep -q "ROLE_CONSISTENCY_VIOLATION" "$ROLE_FAIL_REPORT" 2>/dev/null; then
  role_violation_ok=true
else
  role_violation_ok=false
fi
check "report identifies the ROLE_CONSISTENCY_VIOLATION violation" "$role_violation_ok"

if [ ! -e "$ROLE_FAIL_OUTPUT" ]; then
  role_no_output_ok=true
else
  role_no_output_ok=false
fi
check "no output was written at $ROLE_FAIL_OUTPUT (write was actually aborted)" "$role_no_output_ok"

if grep -q '"eventType": "CONTRACT_VALIDATION"' "$ROLE_FAIL_EVENTS" 2>/dev/null \
  && grep -q '"status": "FAILED"' "$ROLE_FAIL_EVENTS" 2>/dev/null \
  && grep -q '"dataset": "orders"' "$ROLE_FAIL_EVENTS" 2>/dev/null \
  && grep -q '"verdict": "Contradicts"' "$ROLE_FAIL_EVENTS" 2>/dev/null; then
  role_fail_event_ok=true
else
  role_fail_event_ok=false
fi
check "a FAILED ContractValidationEvent with orders' roleConformance verdict Contradicts was published to $ROLE_FAIL_EVENTS before the write was aborted" "$role_fail_event_ok"

if grep -q '"eventType": "WRITE"' "$ROLE_FAIL_EVENTS" 2>/dev/null; then
  role_fail_write_event_ok=false
else
  role_fail_write_event_ok=true
fi
check "no WriteEvent was published to $ROLE_FAIL_EVENTS (the write never executed)" "$role_fail_write_event_ok"

# --- Summary ---------------------------------------------------------------
echo ""
echo "======================================"
if [ "$FAILURES" -eq 0 ]; then
  echo -e "${GREEN}✓ Contract regression pack passed (6/6 cases behaved as contracted)${NC}"
  exit 0
else
  echo -e "${RED}✗ Contract regression pack failed ($FAILURES assertion(s) did not hold)${NC}"
  echo "See $PASS_REPORT, $FAIL_REPORT, $DQ_PASS_REPORT, $DQ_FAIL_REPORT, $ROLE_PASS_REPORT, and $ROLE_FAIL_REPORT for full detail."
  exit 1
fi
